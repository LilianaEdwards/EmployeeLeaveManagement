        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;\nflowchart LR\n\n    subgraph EMPDB[\&quot;EmployeeService — EmployeeDb\&quot;]\n        direction TB\n\n        EMP[\&quot;EMPLOYEES&lt;br/&gt;────────────────────&lt;br/&gt;&lt;b&gt;PK&lt;/b&gt; Id : uniqueidentifier&lt;br/&gt;CreatedAtUtc : datetime2 NOT NULL&lt;br/&gt;FullName : nvarchar(100) NOT NULL&lt;br/&gt;Email : nvarchar(254) NOT NULL&lt;br/&gt;Department : nvarchar(100) NOT NULL&lt;br/&gt;PasswordHash : nvarchar(500) NULL&lt;br/&gt;Role : nvarchar(30) NOT NULL&lt;br/&gt;Default: Employee&lt;br/&gt;────────────────────&lt;br/&gt;UNIQUE INDEX: Email\&quot;]\n    end\n\n    subgraph LEAVEDB[\&quot;LeaveService — LeaveDb\&quot;]\n        direction TB\n\n        LR[\&quot;LEAVE REQUESTS&lt;br/&gt;────────────────────&lt;br/&gt;&lt;b&gt;PK&lt;/b&gt; Id : uniqueidentifier&lt;br/&gt;EmployeeId : uniqueidentifier&lt;br/&gt;Type : nvarchar(20) NOT NULL&lt;br/&gt;StartDate : date NOT NULL&lt;br/&gt;EndDate : date NOT NULL&lt;br/&gt;Reason : nvarchar(500) NOT NULL&lt;br/&gt;Status : nvarchar(20) NOT NULL&lt;br/&gt;CreatedAtUtc : datetime2 NOT NULL&lt;br/&gt;ReviewedAtUtc : datetime2 NULL&lt;br/&gt;ReviewedByEmployeeId : uniqueidentifier NULL&lt;br/&gt;ReviewComment : nvarchar(max) NULL&lt;br/&gt;────────────────────&lt;br/&gt;INDEX: EmployeeId&lt;br/&gt;INDEX: Status\&quot;]\n    end\n\n    EMP -.-&gt;|\&quot;Employee information lookup&lt;br/&gt;Logical reference only\&quot;| API[\&quot;EmployeeService&lt;br/&gt;Internal API\&quot;]\n    API -.-&gt;|\&quot;HTTP communication\&quot;| LR\n\n    NOTE[\&quot;IMPORTANT&lt;br/&gt;No physical SQL foreign key&lt;br/&gt;between EmployeeDb and LeaveDb\&quot;]\n\n    EMP ~~~ NOTE\n    LR ~~~ NOTE\n\n    classDef employee fill:#DBEAFE,stroke:#2563EB,color:#1E3A8A\n    classDef leave fill:#DCFCE7,stroke:#16A34A,color:#14532D\n    classDef api fill:#FEF3C7,stroke:#D97706,color:#78350F\n    classDef note fill:#F3F4F6,stroke:#6B7280,color:#111827\n\n    class EMP employee\n    class LR leave\n    class API api\n    class NOTE note\n&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="ZW-cthB73Gji4NSgjyIS-1">
