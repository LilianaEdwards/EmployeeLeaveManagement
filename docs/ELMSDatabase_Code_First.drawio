        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TB\n    subgraph CLIENT[\&quot;Frontend\&quot;]\n        UI[\&quot;LeaveFlow React Application\&quot;]\n        LOGIN[\&quot;Login / Authentication\&quot;]\n        EMP[\&quot;Employee Portal\&quot;]\n        MGMT[\&quot;Management Portal\&quot;]\n    end\n\n    subgraph EMPLOYEE_SERVICE[\&quot;EmployeeService\&quot;]\n        EP[\&quot;EmployeesController\&quot;]\n        AUTH[\&quot;AuthenticationManager\&quot;]\n        ES[\&quot;Employee Business Services\&quot;]\n        EAPI[\&quot;Employee API\&quot;]\n        EDBCTX[\&quot;EmployeeDbContext\&quot;]\n        EDB[\&quot;EmployeeDb\&quot;]\n    end\n\n    subgraph LEAVE_SERVICE[\&quot;LeaveService\&quot;]\n        LP[\&quot;LeaveRequestsController\&quot;]\n        LM[\&quot;LeaveManager\&quot;]\n        VALIDATOR[\&quot;LeaveAllowanceValidator\&quot;]\n        ECLIENT[\&quot;EmployeeApiClient\&quot;]\n        LDBCTX[\&quot;LeaveDbContext\&quot;]\n        LDB[\&quot;LeaveDb\&quot;]\n    end\n\n    subgraph NOTIFICATION_SERVICE[\&quot;NotificationService\&quot;]\n        WORKER[\&quot;Background Worker\&quot;]\n        NOTIFY[\&quot;Notification Processing\&quot;]\n    end\n\n    subgraph DI[\&quot;Dependency Injection Container\&quot;]\n        REG[\&quot;Program.cs Service Registrations\&quot;]\n        DI1[\&quot;DbContext Registrations\&quot;]\n        DI2[\&quot;Service Interface → Implementation\&quot;]\n        DI3[\&quot;HTTP Client Registrations\&quot;]\n        DI4[\&quot;Hosted Service Registration\&quot;]\n    end\n\n    UI --&gt; LOGIN\n    UI --&gt; EMP\n    UI --&gt; MGMT\n\n    LOGIN --&gt; AUTH\n    EMP --&gt; LP\n    MGMT --&gt; LP\n    MGMT --&gt; EP\n\n    REG --&gt; DI1\n    REG --&gt; DI2\n    REG --&gt; DI3\n    REG --&gt; DI4\n\n    DI1 -. supplies .-&gt; EDBCTX\n    DI1 -. supplies .-&gt; LDBCTX\n    DI2 -. supplies .-&gt; AUTH\n    DI2 -. supplies .-&gt; ES\n    DI2 -. supplies .-&gt; LM\n    DI2 -. supplies .-&gt; VALIDATOR\n    DI3 -. supplies .-&gt; ECLIENT\n    DI4 -. supplies .-&gt; WORKER\n\n    EP --&gt; ES\n    EP --&gt; EDBCTX\n    AUTH --&gt; EDBCTX\n    ES --&gt; EDBCTX\n    EDBCTX --&gt; EDB\n\n    LP --&gt; LM\n    LM --&gt; VALIDATOR\n    LM --&gt; ECLIENT\n    LM --&gt; LDBCTX\n    LDBCTX --&gt; LDB\n\n    ECLIENT --&gt; EAPI\n    EAPI --&gt; EDBCTX\n\n    WORKER --&gt; NOTIFY&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="Dwv7Uba4L1v5hF28vs-U-177">
